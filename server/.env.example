# Server Runtime
NODE_ENV=production
PORT=10000

# Database (PostgreSQL - Neon, Supabase, or Render Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Authentication & Security (Must be at least 16 characters)
JWT_SECRET="kriya_secure_jwt_secret_production_key_2026"
JWT_EXPIRES_IN="7d"

# CORS Configuration (Vercel Frontend + Local Dev)
CORS_ORIGIN="https://research-buddy-theta.vercel.app,http://localhost:5173,http://localhost:3000"

# AI Integrations (Optional)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/auto"
OPENAI_API_KEY=""

# Google Scholar Sync (Optional)
SERP_API_KEY=""
SCHOLAR_SYNC_ENABLED="false"
SCHOLAR_SYNC_CRON="0 3 * * 0"
